# Get your key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase — identity and the usage meter (see docs/adr/0006, 0007).
# Required: every API route authenticates a bearer token, and /api/valuate
# decrements the caller's Allowance. Project Settings → API in the dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Bypasses row-level security. Server-side only — never ship this to the app.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
