# Get your key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase — create a project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# eBay Developer — https://developer.ebay.com
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret
EBAY_RU_NAME=your_ebay_runame_alias   # RuName from eBay dev portal (not the raw redirect URL)
EBAY_TOKEN_SECRET=64_hex_chars_here   # 64 hex chars = 32 bytes, used for AES-256-GCM token encryption
EBAY_ENVIRONMENT=sandbox              # "sandbox" or "production"

# App URL (used to build callback redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SerpAPI — https://serpapi.com (100 free searches/month on free tier)
SERPAPI_KEY=your_serpapi_key_here
